{
  "name": "wp-director",
  "version": "1.0.0",
  "description": "Quickly record demo and support videos for WordPress sites",
  "scripts": {
    "start": "nodemon --watch server.js --watch server --watch public --watch client --watch vite.config.js server.js",
    "start:prod": "pnpm run client:build && NODE_ENV=production node server.js",
    "client:build": "vite build",
    "record": "playwright test",
    "record:actions": "playwright test recordings/actions-runner.spec.js",
    "record:action": "playwright test recordings/actions-runner.spec.js --grep",
    "show-report": "playwright show-report",
    "show-trace": "playwright show-trace",
    "clean:previews": "rm -rf output/.previews",
    "test:classify": "node tests/translate/test-classify.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@tanstack/react-query": "^5.100.11",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.3.0",
    "range-parser": "^1.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-toastify": "11.0.5",
    "ws": "^8.20.1"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ffmpeg-static",
      "fs-ext-extra-prebuilt"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@wp-playground/cli": "^3.1.34",
    "nodemon": "^3.1.14",
    "vite": "^6.4.2"
  }
}
