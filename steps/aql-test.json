{
  "name": "AQL test",
  "steps": [
    {
      "action": "navigate",
      "url": "/wp-login.php"
    },
    {
      "action": "waitForSelector",
      "selector": "#user_login"
    },
    {
      "action": "fill",
      "selector": "#user_login",
      "value": "admin"
    },
    {
      "action": "fill",
      "selector": "#user_pass",
      "value": "password"
    },
    {
      "action": "click",
      "selector": "#wp-submit"
    },
    {
      "action": "waitForSelector",
      "selector": "#wpadminbar"
    },
    {
      "action": "wpInstallPlugin",
      "slug": "advanced-query-loop",
      "activate": true
    },
    {
      "action": "wpNavigate",
      "screen": "new-post"
    },
    {
      "action": "waitForSelector",
      "selector": ".editor-post-title"
    },
    {
      "action": "wpInsertBlock",
      "blockType": "paragraph"
    }
  ]
}