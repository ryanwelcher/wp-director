{
  "name": "playwright-recorder",
  "version": "1.0.0",
  "description": "Record video walkthroughs of websites using Playwright",
  "scripts": {
    "start": "node server.js",
    "record": "playwright test",
    "record:wp": "playwright test recordings/wp-admin.spec.js recordings/wp-frontend.spec.js",
    "record:external": "playwright test recordings/example.spec.js",
    "record:steps": "playwright test recordings/steps-runner.spec.js",
    "record:step": "playwright test recordings/steps-runner.spec.js --grep",
    "show-report": "playwright show-report",
    "show-trace": "playwright show-trace"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@wp-playground/cli": "^3.1.20"
  }
}
