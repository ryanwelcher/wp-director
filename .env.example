ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Drive upload (optional — only needed for "Upload to Drive")
# See SETUP.md → "Google Drive upload" for how to obtain these.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/drive/oauth/callback
# Uploads go to a folder the app creates and owns (drive.file can't write into
# folders you made by hand). Optionally rename it:
# GOOGLE_DRIVE_FOLDER_NAME=WP Director Uploads
