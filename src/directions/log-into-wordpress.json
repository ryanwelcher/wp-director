{
  "name": "Log into WordPress",
  "actions": [
    {
      "label": "Navigate to login page",
      "actions": [{ "action": "navigate", "url": "/wp-login.php" }]
    },
    {
      "label": "Fill in credentials",
      "actions": [
        { "action": "slowType", "selector": "#user_login", "text": "admin" },
        { "action": "slowType", "selector": "#user_pass", "text": "password" }
      ]
    },
    {
      "label": "Submit login form",
      "actions": [{ "action": "highlightClick", "selector": "#wp-submit" }]
    }
  ]
}
