{
  "name": "wp-director",
  "version": "1.0.0",
  "description": "Quickly record demo and support videos for WordPress sites",
  "scripts": {
    "start": "nodemon --watch server.js --watch src server.js",
    "record": "playwright test",
    "record:steps": "playwright test recordings/steps-runner.spec.js",
    "record:step": "playwright test recordings/steps-runner.spec.js --grep",
    "show-report": "playwright show-report",
    "show-trace": "playwright show-trace"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.0",
    "ffmpeg-static": "^5.3.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@wp-playground/cli": "^3.1.20",
    "nodemon": "^3.1.14"
  }
}
