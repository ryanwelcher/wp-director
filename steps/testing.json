{
  "name": "Testing",
  "steps": [
    {
      "label": "Log into WordPress",
      "steps": [
        {
          "action": "navigate",
          "url": "/wp-login.php",
          "waitUntil": "load"
        },
        {
          "action": "waitForSelector",
          "selector": "#user_login"
        },
        {
          "action": "fill",
          "selector": "#user_login",
          "value": "admin"
        },
        {
          "action": "fill",
          "selector": "#user_pass",
          "value": "password"
        },
        {
          "action": "click",
          "selector": "#wp-submit"
        },
        {
          "action": "wait",
          "ms": 500
        }
      ]
    },
    {
      "label": "Install the Astra theme",
      "steps": [
        {
          "action": "wpNavigate",
          "screen": "themes"
        },
        {
          "action": "wait",
          "ms": 500
        },
        {
          "action": "waitForSelector",
          "selector": ".page-title-action"
        },
        {
          "action": "click",
          "selector": ".page-title-action"
        },
        {
          "action": "wait",
          "ms": 500
        },
        {
          "action": "waitForSelector",
          "selector": ".wp-filter-search"
        },
        {
          "action": "fill",
          "selector": ".wp-filter-search",
          "value": "Astra"
        },
        {
          "action": "wait",
          "ms": 600
        },
        {
          "action": "waitForSelector",
          "selector": ".theme-install"
        },
        {
          "action": "click",
          "selector": ".theme-install"
        },
        {
          "action": "wait",
          "ms": 5000
        }
      ],
      "_open": false
    },
    {
      "label": "Click on the site name to navigate to the front end",
      "steps": [
        {
          "action": "waitForSelector",
          "selector": "#wp-admin-bar-site-name > a"
        },
        {
          "action": "click",
          "selector": "#wp-admin-bar-site-name > a"
        },
        {
          "action": "wait",
          "ms": 500
        }
      ]
    }
  ]
}