{
  "name": "Basic Login Test",
  "steps": [
    {
      "action": "navigate",
      "url": "/wp-login.php"
    },
    {
      "action": "fill",
      "selector": "#user_login",
      "value": "admin"
    },
    {
      "action": "fill",
      "selector": "#user_pass",
      "value": "password"
    },
    {
      "action": "click",
      "selector": "#wp-submit"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "wpNavigate",
      "screen": "dashboard"
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "wpNavigate",
      "screen": "posts"
    }
  ]
}