{
  "name": "New Format",
  "steps": [
    {
      "label": "Log into WordPress",
      "steps": [
        {
          "action": "navigate",
          "url": "/wp-login.php"
        },
        {
          "action": "waitForSelector",
          "selector": "#user_login"
        },
        {
          "action": "fill",
          "selector": "#user_login",
          "value": "admin"
        },
        {
          "action": "fill",
          "selector": "#user_pass",
          "value": "password"
        },
        {
          "action": "click",
          "selector": "#wp-submit"
        },
        {
          "action": "waitForSelector",
          "selector": "#wpadminbar"
        }
      ],
      "_open": false
    },
    {
      "label": "Install Hello Dolly",
      "steps": [
        {
          "action": "wpInstallPlugin",
          "slug": "hello-dolly",
          "activate": true
        },
        {
          "action": "wait",
          "ms": 500
        }
      ],
      "_open": false
    },
    {
      "label": "Create a new post",
      "steps": [
        {
          "action": "wpNavigate",
          "screen": "new-post"
        },
        {
          "action": "wait",
          "ms": 600
        },
        {
          "action": "wpSetPostTitle",
          "title": "My New Post"
        },
        {
          "action": "wait",
          "ms": 400
        }
      ],
      "_open": false
    },
    {
      "label": "Go to the Dashboard",
      "steps": [
        {
          "action": "wpNavigate",
          "screen": "dashboard"
        },
        {
          "action": "wait",
          "ms": 600
        }
      ]
    },
    {
      "label": "Move a dashboard widget",
      "steps": [
        {
          "action": "waitForSelector",
          "selector": ".postbox-container .postbox"
        },
        {
          "action": "hover",
          "selector": ".postbox-container .postbox .hndle"
        },
        {
          "action": "wait",
          "ms": 400
        }
      ],
      "_open": false
    },
    {
      "label": "Toggle the Site Health Status widget closed",
      "steps": [
        {
          "action": "click",
          "selector": "#dashboard_site_health .hndle"
        },
        {
          "action": "wait",
          "ms": 400
        }
      ]
    }
  ]
}