ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Drive upload (optional — only needed for "Upload to Drive")
# See SETUP.md → "Google Drive upload" for how to obtain these.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/drive/oauth/callback
# Folder picker (Google Picker API) — lets you pick any existing Drive folder as
# the upload destination. Both required for the picker; see SETUP.md.
GOOGLE_API_KEY=your-google-browser-api-key
GOOGLE_APP_ID=your-google-cloud-project-number
# Fallback folder used only when you haven't picked one. The app creates and
# owns it (drive.file can't write into folders you made by hand). Optionally
# rename it:
# GOOGLE_DRIVE_FOLDER_NAME=WP Director Uploads
