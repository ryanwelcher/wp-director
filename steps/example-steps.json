{
  "name": "example-insert-delete-blocks",
  "description": "Tests wpInsertBlock and wpDeleteBlock",
  "steps": [
    { "action": "wpNavigate", "screen": "new-post", "waitUntil": "domcontentloaded" },
    { "action": "waitForSelector", "selector": ".edit-post-welcome-guide" },
    { "action": "click", "selector": "button[aria-label='Close']" },
    { "action": "wait", "ms": 800 },

    { "action": "frameLocator", "selector": "iframe[name=\"editor-canvas\"]" },
    { "action": "type", "selector": ".wp-block-post-title", "text": "Block Insert & Delete Test", "delay": 60 },
    { "action": "exitFrame" },
    { "action": "wait", "ms": 400 },

    { "action": "wpInsertBlock", "blockType": "paragraph" },
    { "action": "wait", "ms": 400 },

    { "action": "wpInsertBlock", "blockType": "heading" },
    { "action": "wait", "ms": 400 },

    { "action": "wpInsertBlock", "blockType": "image" },
    { "action": "wait", "ms": 600 },

    { "action": "wpDeleteBlock", "blockType": "image", "index": 0 },
    { "action": "wait", "ms": 600 },

    { "action": "wpSelectBlock", "blockType": "heading", "index": 0 },
    { "action": "wait", "ms": 400 }
  ]
}
