{
  "name": "demo",
  "steps": [
    {
      "action": "navigate",
      "url": "/wp-login.php",
      "waitUntil": "load"
    },
    {
      "action": "waitForSelector",
      "selector": "#user_login"
    },
    {
      "action": "fill",
      "selector": "#user_login",
      "value": "admin"
    },
    {
      "action": "fill",
      "selector": "#user_pass",
      "value": "password"
    },
    {
      "action": "click",
      "selector": "#wp-submit"
    },
    {
      "action": "waitForSelector",
      "selector": "#wpadminbar",
      "timeout": 10000
    },
    {
      "action": "wpNavigate",
      "screen": "plugins"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "wpInstallPlugin",
      "slug": "gutenberg",
      "activate": true
    },
    {
      "action": "wpNavigate",
      "screen": "posts"
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "wpNavigate",
      "screen": "new-post"
    },
    {
      "action": "wait",
      "ms": 500
    }
  ]
}