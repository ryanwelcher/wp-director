{
  "name": "Go to templates",
  "steps": [
    {
      "label": "Log into WordPress",
      "steps": [
        {
          "action": "wpNavigate",
          "screen": "dashboard"
        },
        {
          "action": "waitForSelector",
          "selector": "#user_login"
        },
        {
          "action": "fill",
          "selector": "#user_login",
          "value": "admin"
        },
        {
          "action": "fill",
          "selector": "#user_pass",
          "value": "password"
        },
        {
          "action": "click",
          "selector": "#wp-submit"
        },
        {
          "action": "wait",
          "ms": 500
        }
      ]
    },
    {
      "label": "Go to the Site Editor",
      "steps": [
        {
          "action": "wpNavigate",
          "screen": "site-editor"
        },
        {
          "action": "wait",
          "ms": 600
        }
      ]
    },
    {
      "label": "Navigate to the Templates section",
      "steps": [
        {
          "action": "wpNavigate",
          "screen": "site-editor-templates"
        },
        {
          "action": "wait",
          "ms": 600
        }
      ]
    }
  ]
}